{
  "name": "@plicara/pi-audit-loop",
  "version": "0.2.0",
  "description": "One-pass audit workflow for pi: review, route a finding to a fix or simplification, verify, and inspect the final diff.",
  "keywords": ["pi", "pi-package", "pi-extension", "audit", "code-review", "simplify", "skill"],
  "license": "MIT",
  "type": "module",
  "files": ["extensions/", "skills/", "src/phase-machine.ts", "README.md", "LICENSE", "SOURCES.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": ["extensions/"],
    "skills": ["skills/"]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2",
    "typebox": "^1.3.7",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "typebox": "*"
  }
}
